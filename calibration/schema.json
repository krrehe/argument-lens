{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "论证镜校准集",
  "description": "一份病例 + 一张盲标表 + 一份预测。三者用 case_id 与 item_id 对齐。",
  "definitions": {
    "case": {
      "type": "object",
      "required": ["id", "status", "passage", "lens", "mode", "checks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^cal-[0-9]{4}$" },
        "status": { "enum": ["draft", "ready"] },
        "passage": { "type": "string", "minLength": 20 },
        "lens": { "enum": ["walton", "pragma", "ars", "pta", "toulmin", "copi"] },
        "mode": { "enum": ["diagnose", "deep", "redteam", "fallacy", "reconstruct", "interrogate"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "question"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^(?!verdict$)[A-Za-z][A-Za-z0-9_-]{0,15}$" },
              "question": { "type": "string", "minLength": 4 }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "labelRow": {
      "type": "object",
      "required": ["case_id", "annotator", "item_id", "answer"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "annotator": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string" },
        "answer": { "type": "string" },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "note": { "type": "string" }
      }
    },
    "prediction": {
      "type": "object",
      "required": ["case_id", "source", "verdict", "checks"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["withstands", "weakened", "fails", "undetermined"] },
        "checks": {
          "type": "object",
          "additionalProperties": { "enum": ["passed", "unanswered", "violated", "na"] }
        },
        "defeat": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    }
  }
}
