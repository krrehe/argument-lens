{
  "name": "argument-lens",
  "version": "0.1.0",
  "private": true,
  "description": "论证镜 — 非形式逻辑的论证诊断工作台",
  "author": "kk",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prompts": "node scripts/run-dump-prompts.mjs",
    "prompt:lint": "node scripts/run-prompt-lint.mjs",
    "prompt:lock": "node scripts/run-prompt-lock.mjs",
    "check:contract": "node scripts/run-prompt-contract.mjs",
    "check:prompt-drift": "node scripts/run-check-prompt-drift.mjs",
    "check:prompt-history": "node scripts/run-check-prompt-history.mjs",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml -c.electronDist=node_modules/electron/dist",
    "ui:preview": "node scripts/shot-ui.mjs",
    "ui:usage": "node scripts/shot-usage.mjs",
    "ui:disputes": "node scripts/shot-disputes.mjs",
    "ui:empty": "node scripts/shot-empty.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml -c.electronDist=node_modules/electron/dist",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "check:compare": "node scripts/run-check-compare.mjs",
    "check:lens": "node scripts/run-ssr-diagrams.mjs",
    "check:css": "node scripts/check-css-cover.mjs",
    "gloss:sync": "node scripts/gen-workbench-gloss.mjs",
    "check:gloss": "node scripts/check-gloss.mjs",
    "check:archive": "node scripts/check-archive-health.mjs",
    "check:academic": "node scripts/run-check-academic.mjs",
    "check:theory": "node scripts/run-check-theory.mjs",
    "check:landing": "node scripts/run-check-landing.mjs",
    "check:usage": "node scripts/run-check-usage.mjs",
    "eval": "node scripts/eval/run.mjs",
    "eval:audit": "node scripts/eval/run-audit.mjs",
    "pack:check": "node scripts/pack-smoke.mjs",
    "check:prescriptions": "node scripts/run-check-prescriptions.mjs",
    "check:report": "node scripts/run-check-report.mjs",
    "verify": "node scripts/verify.mjs",
