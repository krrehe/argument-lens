    "check:capture": "node scripts/run-check-capture.mjs",
    "check:sameness": "node scripts/run-check-sameness.mjs",
    "check:corpus": "node scripts/run-check-corpus.mjs",
    "check:reread": "node scripts/run-check-reread.mjs",
    "check:rescale": "node scripts/run-check-rescale.mjs",
    "check:conditions": "node scripts/run-check-conditions.mjs",
    "check:portfolio": "node scripts/run-check-portfolio.mjs",
    "check:agreement": "node scripts/run-check-agreement.mjs",
    "check:engine": "node scripts/run-check-engine.mjs",
    "check:views": "node scripts/run-check-views.mjs",
    "check:nextline": "node scripts/run-check-nextline.mjs",
    "check:robustness": "node scripts/run-check-robustness.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "replay": "node scripts/run-replay.mjs",
    "check:replay": "node scripts/run-check-replay.mjs",
    "check:samples": "node scripts/run-check-samples.mjs",
    "check:prg": "node scripts/run-check-prg.mjs",
    "check:sideby": "node scripts/run-check-sideby.mjs",
    "check:modal": "node scripts/run-check-modal.mjs",
    "check:skeleton": "node scripts/run-check-skeleton.mjs",
    "check:rewrite": "node scripts/run-check-rewrite.mjs",
    "check:arch": "node scripts/check-arch.mjs",
    "audit:provenance": "node scripts/run-audit-provenance.mjs",
    "check:provenance": "node scripts/run-check-provenance.mjs",
    "check:terms": "node scripts/run-check-terms.mjs",
    "audit:field-samples": "node scripts/run-audit-field-samples.mjs",
    "audit:field-reports": "node scripts/run-audit-field-reports.mjs",
    "check:field-samples": "node scripts/run-check-field-samples.mjs",
    "check:coverage": "node scripts/run-check-coverage.mjs",
    "check:after": "node scripts/run-check-after.mjs",
    "check:props": "node scripts/run-check-props.mjs",
    "check:pivot": "node scripts/run-check-pivot.mjs",
    "check:flow": "node scripts/run-check-flow.mjs",
    "check:divergence": "node scripts/run-check-divergence.mjs",
    "check:density": "node scripts/run-check-density.mjs",
    "audit:longtext": "node scripts/run-audit-longtext.mjs",
    "eval:bare": "node scripts/eval/run-bare.mjs",
    "eval:compare": "node scripts/eval/compare.mjs"
  },
  "devDependencies": {
    "@argdown/core": "^2.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zip.js/zip.js": "^2.24.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
